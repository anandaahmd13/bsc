{
  "name": "runitup-bsc-launch-watcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reorg-aware, read-only Runitup launch alerts for BSC.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
