# Required. Comma-separate independent HTTPS endpoints for failover.
HTTP_RPC_URLS=https://bsc-rpc.publicnode.com
# Optional but strongly recommended for lower latency. Must be wss://.
WS_RPC_URL=

# Database and scanning
DB_PATH=./data/runitup.sqlite
POLL_INTERVAL_MS=4000
REORG_WINDOW=24
INITIAL_CHUNK_SIZE=100
MIN_CHUNK_SIZE=10
# Optional controlled historical backfill. With no cursor and no value, the
# watcher starts at the current reorg window; it does not spam old launches.
# BOOTSTRAP_BLOCK=126453990
FINALITY_CONFIRMATIONS=15

# Set true for the required observation period: no Telegram message is sent.
DRY_RUN=true

# Required only when DRY_RUN=false.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Comma-separated numeric Telegram user IDs authorized for /status, /pause, /resume, /last.
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_MIN_INTERVAL_MS=1000
